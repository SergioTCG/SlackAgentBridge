{
  "display_information": {
    "name": "Slack Agent Bridge",
    "description": "Control and hand off local Claude Code, Codex, and Pi sessions from Slack",
    "background_color": "#1a1a2e"
  },
  "features": {
    "bot_user": {
      "display_name": "Clavdivs",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/sab-new", "description": "Start a headless Claude, Codex, or Pi session", "usage_hint": "<claude | codex | pi> [folder] [flags]", "should_escape": false },
      { "command": "/sab-model", "description": "Show or set the active session's model", "usage_hint": "[model id or alias]", "should_escape": false },
      { "command": "/sab-effort", "description": "Show or set the active session's reasoning effort", "usage_hint": "[level]", "should_escape": false },
      { "command": "/sab-flags", "description": "Show or change the active session's launch flags", "usage_hint": "[provider flags]", "should_escape": false },
      { "command": "/sab-update", "description": "Update one session or safely sweep all idle active sessions", "usage_hint": "[all]", "should_escape": false },
      { "command": "/sab-stop", "description": "Interrupt the active session's running turn", "should_escape": false },
      { "command": "/sab-switch", "description": "Hand this channel to another provider", "usage_hint": "<claude | codex | pi> [new]", "should_escape": false },
      { "command": "/sab-kill", "description": "End one exact session while keeping its channel resumable", "usage_hint": "[here | session id]", "should_escape": false },
      { "command": "/sab-status", "description": "Show this session or list sessions from the control channel", "usage_hint": "[claude | codex | pi]", "should_escape": false },
      { "command": "/sab-usage", "description": "Show provider usage for this session or the control channel", "usage_hint": "[provider] [days [n] | models | limits]", "should_escape": false },
      { "command": "/sab-run", "description": "Control adaptive routing or a managed Pi run", "usage_hint": "[plan] <goal> | mode | direct | status|approve|pause|continue|cancel", "should_escape": false },
      { "command": "/sab-account", "description": "Show or change a Claude session's subscription", "usage_hint": "[name | default]", "should_escape": false },
      { "command": "/sab-terminal", "description": "List, open, focus, or close optional terminal viewports", "usage_hint": "[list | open | close | open-all | close-all]", "should_escape": false },
      { "command": "/sab-health", "description": "Show bridge daemon health", "should_escape": false },
      { "command": "/sab-cleanup", "description": "Archive dormant session channels", "should_escape": false },
      { "command": "/sab-claim", "description": "Claim this bridge as its owner", "should_escape": false },
      { "command": "/sab-help", "description": "List Slack Agent Bridge commands", "should_escape": false }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:manage",
        "channels:read",
        "channels:history",
        "groups:write",
        "groups:read",
        "groups:history",
        "files:write",
        "files:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
