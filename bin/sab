#!/bin/bash
# sab — the single Slack Agent Bridge command-line interface.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE:0:1}" != "/" ] && SOURCE="$DIR/$SOURCE"
done
BRIDGE="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  sab new <claude|codex|pi> [--cwd DIR] [PROVIDER_FLAGS...]
  sab terminal list [--json]
  sab terminal open <session|tmux|here>
  sab terminal close <session|tmux|here>
  sab terminal open-all|show-all|close-all
  sab account <list|add|set|remove> [name]
  sab account preview [--provider claude|codex|all] [--json]
  sab account capabilities [--probe] [--provider claude|codex|all] [--json]
  sab account registry status [--json]
  sab account registry plan --input FILE|- [--accept-source-change] [--json]
  sab account registry stage --input FILE|- --expected-revision N [--accept-source-change] [--json]
  sab account registry check --channel ID --provider claude|codex [--account EMAIL|ID|ALIAS] [--json]
  sab account pool status --channel ID [--json]
  sab account pool refresh --account ID [--json]
  sab account pool switch --channel ID --session ID --account EMAIL|ID|ALIAS --request-id ID [--json]
  sab account pool reconcile --channel ID --session ID --request-id ID [--json]
  sab account login-codex PROFILE
  sab account login-claude PROFILE
  sab account group list [--json]
  sab account group <create|rename|remove|add|delete-member|drain-member|prefer> ... --revision N --request-id ID [--json]
  sab account manage --input FILE|- [--json]
  sab upload --grant TOKEN -- FILE_PATH [FILE_PATH ...]
  sab team <context|peers|send|send-file|inbox|wait|reply|message|replace|cancel|mode> ...
  sab automation <create|status|stop|validate-flags> ...
  sab node <invite|list|revoke|enroll|status> ...
EOF
}

command_name="${1:-help}"
[ "$#" -eq 0 ] || shift

case "$command_name" in
  new)
    provider="${1:-}"
    case "$provider" in claude|codex|pi) shift ;; *) echo "sab: new requires claude, codex, or pi" >&2; exit 2 ;; esac
    cwd="$PWD"
    if [ "${1:-}" = "--cwd" ]; then
      [ "$#" -ge 2 ] || { echo "sab: --cwd requires a directory" >&2; exit 2; }
      cwd="$2"; shift 2
    elif [[ "${1:-}" == --cwd=* ]]; then
      cwd="${1#--cwd=}"; shift
    fi
    [ -d "$cwd" ] || { echo "sab: directory not found: $cwd" >&2; exit 2; }
    cd "$cwd"
    exec "$BRIDGE/scripts/run-session.sh" "$provider" "$@"
    ;;
  terminal)
    exec node "$BRIDGE/scripts/sab-terminal.mjs" "$@"
    ;;
  account)
    exec "$BRIDGE/scripts/sab-account.sh" "$@"
    ;;
  upload)
    exec node "$BRIDGE/scripts/sab-upload.mjs" "$@"
    ;;
  team)
    exec node "$BRIDGE/scripts/sab-team.mjs" "$@"
    ;;
  automation)
    exec node "$BRIDGE/scripts/sab-automation.mjs" "$@"
    ;;
  node)
    exec node "$BRIDGE/scripts/sab-node.mjs" "$@"
    ;;
  __run)
    # Private daemon/tmux entry point. It is intentionally absent from help.
    provider="${1:-}"
    case "$provider" in claude|codex|pi) shift ;; *) echo "sab: invalid internal provider" >&2; exit 2 ;; esac
    exec "$BRIDGE/scripts/run-session.sh" "$provider" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "sab: unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
