#!/bin/bash
# sab-codex — Slack Agent Bridge launcher for Codex CLI.
# It deliberately does not load Claude's MCP Channel server or consent watcher.

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE:0:1}" != "/" ] && SOURCE="$DIR/$SOURCE"
done
BRIDGE="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

command -v tmux >/dev/null 2>&1 || PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
command -v codex >/dev/null 2>&1 || PATH="/opt/homebrew/bin:$HOME/.local/bin:$PATH"

export CCS_BRIDGE=1
export CCS_PROVIDER=codex
export CCS_FLAGS="$*"
unset CCS_TMUX
# Do not inherit a parent Codex thread identity into a new bridged terminal.
# Authentication/config variables such as CODEX_HOME remain intact.
unset CODEX_THREAD_ID CODEX_TURN_ID CODEX_SESSION_ID 2>/dev/null || true

if [ -z "$TMUX" ] && [ -z "$CCS_NO_TMUX" ] && command -v tmux >/dev/null 2>&1; then
  TN="ccs-codex-$$-$RANDOM"
  q=""
  for a in "$@"; do q+="$(printf '%q' "$a") "; done
  exec tmux new-session -s "$TN" \
    "CCS_BRIDGE=1 CCS_PROVIDER=codex CCS_TMUX=$TN $(printf '%q' "$SOURCE") $q"
fi

if [ -n "$TMUX" ] && [ -z "$CCS_TMUX" ]; then
  CCS_TMUX="$(tmux display-message -p '#S' 2>/dev/null)"
  export CCS_TMUX
fi

direct_codex() {
  # F12 gives the bridge an unambiguous interrupt key that cannot exit an idle TUI.
  exec codex -c 'tui.keymap.chat.interrupt_turn="f12"' "$@"
}

# App Server is the semantic interface that distinguishes user-facing
# commentary from commands, diffs, and reasoning. A transparent loopback proxy
# observes that semantic stream while the visible TUI remains the only client
# controlling the thread. If either sidecar cannot start, preserve the legacy
# hooks + tmux path exactly.
if [ "${CCS_CODEX_APP_SERVER:-1}" = "0" ] || [ -z "$CCS_TMUX" ]; then direct_codex "$@"; fi

RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sab-codex-events.XXXXXX")" || direct_codex "$@"
APP_LOG="$RUNTIME_DIR/app-server.log"
PROXY_LOG="$RUNTIME_DIR/event-proxy.log"
APP_PID=""
PROXY_PID=""

cleanup_sidecars() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$PROXY_PID" ] && kill -0 "$PROXY_PID" 2>/dev/null; then kill "$PROXY_PID" 2>/dev/null || true; fi
  if [ -n "$APP_PID" ] && kill -0 "$APP_PID" 2>/dev/null; then kill "$APP_PID" 2>/dev/null || true; fi
  if [ -n "$PROXY_PID" ]; then wait "$PROXY_PID" 2>/dev/null || true; fi
  if [ -n "$APP_PID" ]; then wait "$APP_PID" 2>/dev/null || true; fi
  rm -f "$APP_LOG" "$PROXY_LOG"
  rmdir "$RUNTIME_DIR" 2>/dev/null || true
  return "$status"
}

fallback_to_direct() {
  printf '%s\n' 'sab-codex: commentary transport unavailable; falling back to the direct Codex TUI.' >&2
  cleanup_sidecars || true
  direct_codex "$@"
}

wait_for_url() {
  log_file=$1
  owner_pid=$2
  for _ in $(seq 1 50); do
    url=$(sed -n 's/.*listening on: \(ws:\/\/127\.0\.0\.1:[0-9][0-9]*\).*/\1/p' "$log_file" 2>/dev/null | head -n 1)
    if [ -n "$url" ]; then printf '%s\n' "$url"; return 0; fi
    kill -0 "$owner_pid" 2>/dev/null || return 1
    sleep 0.1
  done
  return 1
}

codex app-server --listen ws://127.0.0.1:0 >"$APP_LOG" 2>&1 &
APP_PID=$!
CODEX_APP_URL="$(wait_for_url "$APP_LOG" "$APP_PID")" || fallback_to_direct "$@"

node "$BRIDGE/scripts/codex-event-proxy.mjs" \
  --upstream "$CODEX_APP_URL" --agent-pid "$APP_PID" --tmux "$CCS_TMUX" >"$PROXY_LOG" 2>&1 &
PROXY_PID=$!
CODEX_PROXY_URL="$(wait_for_url "$PROXY_LOG" "$PROXY_PID")" || fallback_to_direct "$@"

trap cleanup_sidecars EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
codex --remote "$CODEX_PROXY_URL" -c 'tui.keymap.chat.interrupt_turn="f12"' "$@"
exit $?
